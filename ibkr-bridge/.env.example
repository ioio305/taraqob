# انسخ هذا الملف إلى .env على الخادم واملأه هناك فقط — لا ترفعه إلى GitHub ولا ترسله في محادثة.

# بيانات دخول Interactive Brokers (يكتبها المالك بنفسه على الخادم)
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=live          # live مع READ_ONLY_API=yes (مفروض في docker-compose) — لا أوامر ممكنة
IB_PORT=4003               # 4003 للحساب الحقيقي، 4004 لو استخدمت حساب Paper مع مشاركة البيانات

# النطاق الفرعي الذي يشير إلى عنوان IP الخادم (سجل A في DNS)، مثل: ibkr.trqob.com
BRIDGE_DOMAIN=

# مفتاح سري طويل عشوائي (40 حرفاً فأكثر). نفس القيمة توضع في Vercel باسم IBKR_BRIDGE_TOKEN
# توليده على الخادم:  openssl rand -hex 24
BRIDGE_TOKEN=

# إعادة تشغيل IB Gateway يومياً خارج الجلسة (توقيت نيويورك)
AUTO_RESTART_TIME=11:45 PM
