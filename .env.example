# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://taraqob.vercel.app

# ── Tradier (اختياري) ───────────────────────────────────────────────────────
# إن تُرك فارغاً، تسقط المنصة تلقائياً إلى Yahoo Finance للأسعار والشموع،
# وإلى سلسلة عقود Black-Scholes تركيبية. أضِف المفتاح لبيانات عقود حقيقية.
TRADIER_API_KEY=your_tradier_api_key

# ── Stripe ────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in Stripe Dashboard > Products
STRIPE_SIGNAL_PRICE_ID=price_...
STRIPE_EDGE_PRICE_ID=price_...
STRIPE_ALPHA_PRICE_ID=price_...

# ── News & Economic Calendar ──────────────────────────────────────────────
# Finnhub (primary) — https://finnhub.io  (free tier: 60 req/min)
FINNHUB_API_KEY=your_finnhub_api_key

# Financial Modeling Prep (fallback) — https://financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key

# ── Resend (email) ─────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=noreply@taraqob.com
