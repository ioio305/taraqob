# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://trqob.com
NEXT_PUBLIC_APP_NAME=ترقّب

# اتركها false حتى اعتماد الأسعار وتشغيل الدفع.
# عند تحويلها إلى true تصبح اشتراكات المنصات إلزامية.
PLATFORM_BILLING_ENFORCED=false

# Vercel Cron authentication. Generate a long random value and keep it server-only.
CRON_SECRET=replace_with_a_long_random_secret
RATE_LIMIT_SECRET=replace_with_another_long_random_secret

# ── Tradier (اختياري) ───────────────────────────────────────────────────────
# إن تُرك فارغاً، تسقط المنصة تلقائياً إلى Yahoo Finance للأسعار والشموع،
# وإلى سلسلة عقود Black-Scholes تركيبية. أضِف المفتاح لبيانات عقود حقيقية.
TRADIER_API_KEY=your_tradier_api_key

# ── Market data fallbacks ─────────────────────────────────────────────────
POLYGON_API_KEY=your_polygon_api_key
POLYGON_BASE_URL=https://api.polygon.io

# ── AI assistant ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — create these in Stripe Dashboard > Products
STRIPE_SIGNAL_PRICE_ID=price_...
STRIPE_EDGE_PRICE_ID=price_...
STRIPE_ALPHA_PRICE_ID=price_...
STRIPE_SIGNAL_YEARLY_PRICE_ID=price_...
STRIPE_EDGE_YEARLY_PRICE_ID=price_...
STRIPE_ALPHA_YEARLY_PRICE_ID=price_...

# أسعار المنصات المستقلة:
# منصة واحدة: STRIPE_{SPX|STOCKS|FUNDS}_{SIGNAL|EDGE|ALPHA}_PRICE_ID
# أي منصتين: STRIPE_DUO_{SIGNAL|EDGE|ALPHA}_PRICE_ID
# الشامل: STRIPE_ALL_{SIGNAL|EDGE|ALPHA}_PRICE_ID
# أضف _YEARLY قبل _PRICE_ID للأسعار السنوية.
STRIPE_SPX_SIGNAL_PRICE_ID=price_...
STRIPE_STOCKS_SIGNAL_PRICE_ID=price_...
STRIPE_FUNDS_SIGNAL_PRICE_ID=price_...
STRIPE_DUO_SIGNAL_PRICE_ID=price_...
STRIPE_ALL_SIGNAL_PRICE_ID=price_...

# ── News & Economic Calendar ──────────────────────────────────────────────
# Finnhub (primary) — https://finnhub.io  (free tier: 60 req/min)
FINNHUB_API_KEY=your_finnhub_api_key

# Financial Modeling Prep (fallback) — https://financialmodelingprep.com
FMP_API_KEY=your_fmp_api_key

# ── Resend (email) ─────────────────────────────────────────────────────────
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a verified domain in Resend
RESEND_FROM_EMAIL=noreply@taraqob.com
